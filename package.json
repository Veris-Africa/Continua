{
  "name": "continua-workspace",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm --workspace app run dev",
    "build": "npm run security:check && npm --workspace app run build && node infra/security/browser-secret-audit.mjs app/dist && node infra/security/managed-auth-build-audit.mjs app/dist",
    "build:dev": "npm --workspace app run build:dev",
    "lint": "npm --workspace app run lint",
    "preview": "npm --workspace app run preview",
    "security:check": "node --test infra/cloudflare/*.test.mjs && node node_modules/typescript/bin/tsc --noEmit -p app/tsconfig.app.json"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "buffer": "^6.0.3",
    "express": "^5.3.0",
    "html-to-image": "^1.11.13",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "minimatch": "^11.0.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@eslint/eslintrc": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
